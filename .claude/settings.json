{
  "permissions": {
    "allow": [
      "PowerShell(./.claude/scripts/free-port.ps1 *)",
      "PowerShell(.\\.claude\\scripts\\free-port.ps1 *)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File .claude/scripts/free-port.ps1 *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.sh\"",
            "timeout": 10,
            "statusMessage": "Git の開発ルールを確認中"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-ports.sh\"",
            "timeout": 10,
            "statusMessage": "サーバーのポートの決まりを確認中"
          }
        ]
      }
    ]
  }
}
